# Production env — copy to .env on the droplet and fill in real values.
DJANGO_SECRET_KEY=CHANGE-ME-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=agamos.events,www.agamos.events,app.agamos.events
CSRF_TRUSTED_ORIGINS=https://agamos.events,https://www.agamos.events,https://app.agamos.events
CORS_ALLOWED_ORIGINS=https://agamos.events,https://app.agamos.events
FRONTEND_URL=https://agamos.events
SECURE_SSL_REDIRECT=1

# PostgreSQL (set these to use Postgres; leave POSTGRES_DB empty for SQLite).
POSTGRES_DB=agamos
POSTGRES_USER=agamos
POSTGRES_PASSWORD=CHANGE-ME-strong-db-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Contact form notifications land here (also shown on the public Contact page).
CONTACT_EMAIL=getagamos@gmail.com

# Paystack keys (use TEST keys to launch; swap to LIVE when ready)
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx

# Cloudinary (so uploads go to the CDN, not the droplet disk)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=xxxxxxxxxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
