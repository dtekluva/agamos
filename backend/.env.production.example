# Production env — copy to .env on the droplet and fill in real values.
DJANGO_SECRET_KEY=CHANGE-ME-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=agamos.example.com,www.agamos.example.com
CSRF_TRUSTED_ORIGINS=https://agamos.example.com,https://www.agamos.example.com
CORS_ALLOWED_ORIGINS=https://agamos.example.com
FRONTEND_URL=https://agamos.example.com
SECURE_SSL_REDIRECT=1

# Paystack LIVE (or TEST) keys
PAYSTACK_SECRET_KEY=sk_live_xxx
PAYSTACK_PUBLIC_KEY=pk_live_xxx

# Cloudinary (recommended in production so uploads aren't on the droplet's disk)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=xxxxxxxxxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
